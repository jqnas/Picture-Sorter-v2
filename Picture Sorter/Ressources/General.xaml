<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Picture_Sorter.Convertors">

    <!--Provides the default font for the application-->
    <FontFamily x:Key="DefaultFont">Bahnschrift</FontFamily>

    <!-- Convertors -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:PercentageConverter x:Key="PercentageConverter"/>
    <conv:IndexPlusOneConverter x:Key="IndexPlusOneConverter"/>
    <conv:IndexToNumberConvertor x:Key="IndexToNumberConvertor"/>
    <conv:FileSizeConvertor x:Key="FileSizeConvertor"/>
    <conv:InverseBoolConvertor x:Key="InverseBoolConvertor"/>
    <conv:TransferActionconvertor x:Key="TransferActionconvertor"/>

    <!--ToolTip-->
    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFont}"/>
    </Style>


    <!-- Context Menu -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="templateBorder" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4" 
                            Margin="4,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Content (Text/Header) -->
                            <ContentPresenter ContentSource="Header" 
                                              Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="Center" 
                                              Grid.Column="1"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="templateBorder" Property="Background" Value="{DynamicResource ListItemBackgroundSelected}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <!-- IsChecked State -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="templateBorder" Property="Background" Value="{DynamicResource ListItemBackgroundHover}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="templateBorder" Property="Background" Value="{DynamicResource ListItemBackgroundSelected}" />
                            <Setter Property="Foreground" Value="White" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 2. Style for the ContextMenu container itself -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Seperator}" />
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>