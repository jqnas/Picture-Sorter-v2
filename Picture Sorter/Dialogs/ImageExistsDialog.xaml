<Window x:Class="Picture_Sorter.Dialogs.ImageExistsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Picture_Sorter"
        mc:Ignorable="d"
        Height="600" Width="900"
        Padding="20"
        AllowDrop="False"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Image exists"
        Icon="/Icons/Picture.ico"
        Background="{DynamicResource AppBackgroundSecondary}"
        KeyDown="Window_KeyDown">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="45*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="6.5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- New image labels -->
        <StackPanel Grid.Column="0" Grid.Row="0" Margin="10">
            <TextBlock Text="{Binding NewImage.UIFileName, FallbackValue='PATH', TargetNullValue='[Empty]', Mode=OneWay}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="25"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding NewImage.SourcePath,  FallbackValue='FULL PATH', TargetNullValue='[Empty]', Mode=OneWay}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Margin="0,5,0,0"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- New image -->
        <Border Grid.Column="0" Grid.Row="1"
                Margin="10,5"
                BorderBrush="{DynamicResource TextPrimary}" BorderThickness="2" Background="Black" CornerRadius="5">
            <Image x:Name="NewImageContainer" Stretch="Uniform"/>
        </Border>

        <!-- New image Infos -->
        <DockPanel Grid.Column="0" Grid.Row="2"
                    Margin="20,10"
                    LastChildFill="True" VerticalAlignment="Center">
            <TextBlock Text="{Binding NewImage.UIResolution, FallbackValue='RESOLUTION', TargetNullValue='[Empty]', Mode=OneWay}"
                       DockPanel.Dock="Left"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                       TextAlignment="Left"
                       Width="150"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding NewImage.UICaptureDate, FallbackValue='DATE', TargetNullValue='[Empty]', Mode=OneWay}"
                       DockPanel.Dock="Right"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                       TextAlignment="Right"
                       Width="150"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding NewImage.UISize, FallbackValue='SIZE', TargetNullValue='[Empty]', Mode=OneWay}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        


        <!-- Existing image labels -->
        <StackPanel Grid.Column="2" Grid.Row="0" Margin="10">
            <TextBlock Text="{Binding ExistingImage.UIFileName, FallbackValue='PATH', TargetNullValue='[Empty]', Mode=OneWay}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="25"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding ExistingImage.SourcePath,  FallbackValue='FULL PATH', TargetNullValue='[Empty]', Mode=OneWay}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Margin="0,5,0,0"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        
        
        <!-- Arrow-->
        <Image Source="{DynamicResource NextImageIcon}" Stretch="Uniform" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>


        <!-- Existing image -->
        <Border Grid.Column="2" Grid.Row="1"
                Margin="10,5"
                BorderBrush="{DynamicResource TextPrimary}" BorderThickness="2" Background="Black" CornerRadius="5">
            <Image x:Name="ExistingImageContainer" Stretch="Uniform"/>
        </Border>

        <!-- Existing image Infos -->
        <DockPanel Grid.Column="2" Grid.Row="2"
            Margin="20,10"
            LastChildFill="True" VerticalAlignment="Center">
            <TextBlock Text="{Binding ExistingImage.UIResolution, FallbackValue='RESOLUTION', TargetNullValue='[Empty]', Mode=OneWay}"
                       DockPanel.Dock="Left"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                       TextAlignment="Left"
                       Width="150"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding ExistingImage.UICaptureDate, FallbackValue='DATE', TargetNullValue='[Empty]', Mode=OneWay}"
                       DockPanel.Dock="Right"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                       TextAlignment="Right"
                       Width="150"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding ExistingImage.UISize, FallbackValue='SIZE', TargetNullValue='[Empty]', Mode=OneWay}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        
        <!-- Buttons -->
        <DockPanel LastChildFill="True"
                   Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3"
                   Margin="50,0">

            <!-- Overwrite Button -->
            <Button x:Name="OverwriteBtn"
                    DockPanel.Dock="Left"
                    Style="{DynamicResource PrimaryButton}"
                    Margin="10,0"
                    ToolTip="Overwrites the existing file"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    TabIndex="1"
                    Click="OverwriteBtn_Click">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Image Source="{DynamicResource CopyIcon}"
                           Width="30"
                           Stretch="Uniform"/>
                    <TextBlock Text="Overwrite" FontFamily="{DynamicResource DefaultFont}" FontSize="25" Margin="10,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Cancel Button -->
            <Button x:Name="CancelBtn"
                    DockPanel.Dock="Right"
                    Style="{DynamicResource RedButton}"
                    Margin="10,0"
                    ToolTip="Cancel operation"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    TabIndex="3"
                    Click="CancelBtn_Click">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Image Source="{DynamicResource CloseIcon}"
                           Width="30"
                           Stretch="Uniform"/>
                    <TextBlock Text="Cancel" FontFamily="{DynamicResource DefaultFont}" FontSize="25" Margin="10,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Rename Button -->
            <Button x:Name="RenameBtn"
                    Style="{DynamicResource PrimaryButton}"
                    Margin="10,0"
                    ToolTip="Renames the new file"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    TabIndex="2"
                    Click="RenameBtn_Click">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Image Source="{DynamicResource RenameIcon}"
                           Width="30"
                           Stretch="Uniform"/>
                    <TextBlock Text="Rename" FontFamily="{DynamicResource DefaultFont}" FontSize="25" Margin="10,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </DockPanel>

    </Grid>
    
</Window>
