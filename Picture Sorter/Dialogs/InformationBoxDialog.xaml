<Window x:Class="Picture_Sorter.Dialogs.InformationBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Picture_Sorter"
        mc:Ignorable="d"
        Height="220" Width="550"
        Padding="20"
        AllowDrop="False"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Title"
        Icon="/Icons/Picture.ico"
        Background="{DynamicResource AppBackgroundSecondary}"
        KeyDown="Window_KeyDown">

    <Grid>
        
        <StackPanel Margin="20">

            <!-- Text -->
            <TextBlock x:Name="Text" Height="55" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource DefaultFont}" FontSize="15" TextWrapping="Wrap" MaxHeight="100" HorizontalAlignment="Center"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        Height="55"
                        Margin="20,20,20,10"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- OK Button -->
                <Button x:Name="OkBtn"
                        Style="{DynamicResource PrimaryButton}"
                        Width="120" Height="50"
                        Margin="10,0"
                        ToolTip="OK"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        TabIndex="1"
                        Visibility="Collapsed"
                        Click="OkBtn_Click">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="OK" FontFamily="{DynamicResource DefaultFont}" FontSize="20" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- YES Button -->
                <Button x:Name="YesBtn"
                        Style="{DynamicResource PrimaryButton}"
                        Width="120" Height="50"
                        Margin="10,0"
                        ToolTip="YES"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        TabIndex="2"
                        Visibility="Collapsed"
                        Click="YesBtn_Click">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="YES" FontFamily="{DynamicResource DefaultFont}" FontSize="20" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- NO Button -->
                <Button x:Name="NoBtn"
                        Style="{DynamicResource PrimaryButton}"
                        Width="120" Height="50"
                        Margin="10,0"
                        ToolTip="NO"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        TabIndex="3"
                        Visibility="Collapsed"
                        Click="NoBtn_Click">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="NO" FontFamily="{DynamicResource DefaultFont}" FontSize="20" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Retry Button -->
                <Button x:Name="RetryBtn"
                        Style="{DynamicResource PrimaryButton}"
                        Width="120" Height="50"
                        Margin="10,0"
                        ToolTip="Cancel"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        TabIndex="5"
                        Visibility="Collapsed"
                        Click="RetryBtn_Click">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Retry" FontFamily="{DynamicResource DefaultFont}" FontSize="20" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Cancel Button -->
                <Button x:Name="CancelBtn"
                        Style="{DynamicResource RedButton}"
                        Width="120" Height="50"
                        Margin="10,0"
                        ToolTip="Cancel"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        TabIndex="4"
                        Visibility="Collapsed"
                        Click="CancelBtn_Click">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Cancel" FontFamily="{DynamicResource DefaultFont}" FontSize="20" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </StackPanel>

    </Grid>

</Window>
