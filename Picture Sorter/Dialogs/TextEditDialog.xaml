<Window x:Class="Picture_Sorter.Dialogs.TextEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Picture_Sorter.Dialogs"
        mc:Ignorable="d"
        Height="220" Width="550"
        Padding="20"
        AllowDrop="False"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Title"
        Icon="/Icons/Picture.ico"
        Background="{DynamicResource AppBackgroundSecondary}"
        KeyDown="Window_KeyDown">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0"
                    Margin="20,0"
                    VerticalAlignment="Center">

            <TextBlock x:Name="ActionText"
                       Text="Action:"
                       Foreground="{DynamicResource TextPrimary}"
                       FontFamily="{DynamicResource DefaultFont}" FontSize="25"
                       Margin="0,0,0,5"/>

            <!-- Text box -->
            <Border BorderBrush="{DynamicResource Seperator}"
                    BorderThickness="2"
                    CornerRadius="5"
                    Height="50">

                <TextBox x:Name="Text" Margin="10" Text="Text"
                         Background="{DynamicResource AppBackgroundSecondary}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         TabIndex="1"
                         CaretBrush="{DynamicResource TextPrimary}"
                         FontFamily="{DynamicResource DefaultFont}" FontSize="20"
                         HorizontalAlignment="Stretch"
                         TextChanged="Text_TextChanged" VerticalAlignment="Center"
                         KeyDown="Text_KeyDown">
                </TextBox>

            </Border>
            

            
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    Height="55"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- OK Button -->
            <Button x:Name="OkBtn"
                    Style="{DynamicResource PrimaryButton}"
                    Width="120" Height="50"
                    Margin="10,0"
                    ToolTip="OK"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    TabIndex="2"
                    IsEnabled="{Binding IsValidInput, FallbackValue=True, TargetNullValue=True, Mode=OneWay}"
                    Click="OkBtn_Click">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="OK" FontFamily="{DynamicResource DefaultFont}" FontSize="20" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Cancel Button -->
            <Button x:Name="CancelBtn"
                    Style="{DynamicResource RedButton}"
                    Width="120" Height="50"
                    Margin="10,0"
                    ToolTip="Cancel"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    TabIndex="3"
                    Click="CancelBtn_Click">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Cancel" FontFamily="{DynamicResource DefaultFont}" FontSize="20" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </StackPanel>

    </Grid>

</Window>
