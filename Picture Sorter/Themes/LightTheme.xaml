<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="AppBackground" Color="White"/>
    <SolidColorBrush x:Key="AppBackgroundSecondary" Color="#FFCACACA"/>
    <SolidColorBrush x:Key="TextPrimary" Color="Black"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#454545"/>
    <SolidColorBrush x:Key="TextStrong" Color="Black"/>
    <SolidColorBrush x:Key="AccentPrimary" Color="#569CCE"/>
    <SolidColorBrush x:Key="AccentSecondary" Color="#5eb0eb"/>
    <SolidColorBrush x:Key="AccentThird" Color="#3D8CC5"/>
    <SolidColorBrush x:Key="ToolButtonBackgroundHover" Color="#44000000"/>
    <SolidColorBrush x:Key="RedToolButtonBackgroundHover" Color="#44FF0000"/>
    <SolidColorBrush x:Key="ListItemBackgroundHover" Color="#22000000"/>
    <SolidColorBrush x:Key="ListItemBackgroundSelected" Color="#44569CCE"/>
    <SolidColorBrush x:Key="SliderBackground" Color="Gray"/>
    <SolidColorBrush x:Key="SliderActive" Color="#569CCE"/>
    <SolidColorBrush x:Key="SliderDot" Color="#569CCE"/>
    <SolidColorBrush x:Key="SliderDotBorder" Color="#454545"/>
    <SolidColorBrush x:Key="ScrollBar" Color="#FFA5A5A5"/>
