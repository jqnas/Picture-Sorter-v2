    <SolidColorBrush x:Key="ScrollBarDrag" Color="#454545"/>
    <SolidColorBrush x:Key="Button" Color="#5eb0eb"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#569CCE"/>
    <SolidColorBrush x:Key="ButtonPress" Color="#3D8CC5"/>
    <SolidColorBrush x:Key="Seperator" Color="#454545"/>
    <SolidColorBrush x:Key="KeyBoardActiveBorder" Color="Black"/>
    <SolidColorBrush x:Key="SplitViewBackground" Color="#66569CCE"/>

