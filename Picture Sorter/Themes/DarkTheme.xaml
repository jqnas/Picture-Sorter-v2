<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="AppBackground" Color="Black"/>
    <SolidColorBrush x:Key="AppBackgroundSecondary" Color="#0f0f0f"/>
    <SolidColorBrush x:Key="TextPrimary" Color="DarkGray"/>
    <SolidColorBrush x:Key="TextSecondary" Color="Gray"/>
    <SolidColorBrush x:Key="TextStrong" Color="White"/>
    <SolidColorBrush x:Key="AccentPrimary" Color="#569CCE"/>
    <SolidColorBrush x:Key="AccentSecondary" Color="#5eb0eb"/>
    <SolidColorBrush x:Key="AccentThird" Color="#3D8CC5"/>
    <SolidColorBrush x:Key="ToolButtonBackgroundHover" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="RedToolButtonBackgroundHover" Color="#44FF0000"/>
    <SolidColorBrush x:Key="ListItemBackgroundHover" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ListItemBackgroundSelected" Color="#445eb0eb"/>
    <SolidColorBrush x:Key="SliderBackground" Color="DarkGray"/>
    <SolidColorBrush x:Key="SliderActive" Color="#569CCE"/>
    <SolidColorBrush x:Key="SliderDot" Color="#569CCE"/>
    <SolidColorBrush x:Key="SliderDotBorder" Color="#454545"/>
    <SolidColorBrush x:Key="ScrollBar" Color="DarkGray"/>
    <SolidColorBrush x:Key="ScrollBarHover" Color="Gray"/>
    <SolidColorBrush x:Key="ScrollBarDrag" Color="#454545"/>
    <SolidColorBrush x:Key="Button" Color="#5eb0eb"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#569CCE"/>
    <SolidColorBrush x:Key="ButtonPress" Color="#3D8CC5"/>
    <SolidColorBrush x:Key="Seperator" Color="DarkGray"/>
    <SolidColorBrush x:Key="KeyBoardActiveBorder" Color="White"/>
    <SolidColorBrush x:Key="SplitViewBackground" Color="#4C569CCE"/>

    <!-- Icons -->
    <BitmapImage x:Key="CloseIcon" UriSource="/Icons/DarkMode/Close.png"/>
    <BitmapImage x:Key="MaximizeIcon" UriSource="/Icons/DarkMode/Maximize.png"/>
    <BitmapImage x:Key="MinimizeIcon" UriSource="/Icons/DarkMode/Minimize.png"/>
    <BitmapImage x:Key="PreviousImageIcon" UriSource="/Icons/DarkMode/Previus-Image.png"/>
    <BitmapImage x:Key="NextImageIcon" UriSource="/Icons/DarkMode/Next-Image.png"/>
    <BitmapImage x:Key="ThemeSwitcherIcon" UriSource="/Icons/DarkMode/Theme-Switcher.png"/>
