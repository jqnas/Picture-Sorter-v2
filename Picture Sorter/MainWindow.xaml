<Window x:Class="Picture_Sorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Picture_Sorter"
        xmlns:conv="clr-namespace:Picture_Sorter.Convertors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:lmimgz="clr-namespace:LinkingMountains.ImageZoom;assembly=LinkingMountains.ImageZoom"
        mc:Ignorable="d"
        MinWidth="900" MinHeight="600"
        Width="1300" Height="800"
        ResizeMode="CanResizeWithGrip"
        Title="Picture Sorter v2"
        Icon="/Icons/Picture.ico"
        WindowState="Normal"
        AllowsTransparency="False"
        BorderThickness="1.5" 
        Background="{DynamicResource AppBackgroundSecondary}"
        Style="{DynamicResource PicturSorterWindowStyle}"
        BorderBrush="{DynamicResource TextSecondary}"
        AllowDrop="False"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Windoe_PreviewKeyDown"
        SizeChanged="Window_SizeChanged"
        x:Name="Window">

    <Window.Resources>
        <!-- Default image -->
        <BitmapImage x:Key="DefaultImage" UriSource="Default.png"/>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragEnter="Window_DragEnter"
          DragOver="Window_DragOver"
          DragLeave="Window_DragLeave"
          Drop="Window_Drop">

        <!-- Loading screen -->
        <Grid x:Name="LoadingScreen"
              Background="#7F000000"
              Panel.ZIndex="101"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed', Mode=OneWay}">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="Loading..."
                           Foreground="White"
                           FontFamily="{DynamicResource DefaultFont}" FontSize="45"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="LoadingTextBlock"
                           Foreground="White"
                           FontFamily="{DynamicResource DefaultFont}" FontSize="20"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
            
            
        </Grid>
        
        <!-- Search box backdrop -->
        <Grid x:Name="SearchBoxBackdrop"
              Background="Transparent"
              Panel.ZIndex="97"
              Visibility="Collapsed" 
              MouseLeftButtonDown="SearchBoxBackdrop_MouseLeftButtonDown" />
        <!-- {Binding ElementName=SearchBoxArea, Path=Visibility} -->

        <!-- Search area -->
        <Border x:Name="SearchBoxArea"
                CornerRadius="5"
                Panel.ZIndex="98"
                Width="350" Height="45"
                Background="{DynamicResource AppBackgroundSecondary}"
                BorderBrush="{DynamicResource Seperator}"
                BorderThickness="2"
                Margin="0,30,0,0"
                Padding="5"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed', Mode=TwoWay}">

            <DockPanel LastChildFill="True">

                <!-- Search controls -->
                <!-- Search next -->
                <Button x:Name="SearchNextBtn"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource WindowToolButton}"
                        ToolTip="Search next [Tab]"
                        Width="30" Height="30"
                        Tag="{DynamicResource ToolButtonBackgroundHover}"
                        Click="SearchNextBtn_Click">
                    <Image Source="{DynamicResource NextImageIcon}" Margin="5"/>
                </Button>

                <!-- Search next -->
                <Button x:Name="SearchPreviousBtn"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource WindowToolButton}"
                        ToolTip="Search previous [Shift+Tab]"
                        Margin="0,0,5,0"
                        Width="30" Height="30"
                        Tag="{DynamicResource ToolButtonBackgroundHover}"
                        Click="SearchPreviousBtn_Click">
                    <Image Source="{DynamicResource PreviousImageIcon}" Margin="5"/>
                </Button>

                <!-- Search counter -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding SearchCounter.CurrentResultNumber, FallbackValue='0', TargetNullValue='0', Mode=OneWay}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{DynamicResource DefaultFont}" FontSize="20"/>
                    <TextBlock Text="/"
                                Foreground="{DynamicResource TextPrimary}"
                                FontFamily="{DynamicResource DefaultFont}" FontSize="20"/>
                    <TextBlock Text="{Binding SearchCounter.TotalResults, FallbackValue='0', TargetNullValue='0', Mode=OneWay}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{DynamicResource DefaultFont}" FontSize="20"/>

                </StackPanel>


                <Grid>

                    <!-- Search box -->
                    <TextBox x:Name="SearchBox"
                             FontFamily="{DynamicResource DefaultFont}" FontSize="20"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             BorderThickness="0"
                             Margin="5,-4,0,-7"
                             CaretBrush="{DynamicResource TextPrimary}"
                             Foreground="{DynamicResource TextPrimary}"
                             SelectionBrush="{DynamicResource AccentPrimary}"
                             HorizontalAlignment="Stretch"
                             TextChanged="SearhcBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" VerticalContentAlignment="Center"/>

                    <!-- Search hint -->
                    <TextBlock Text="Type to search..."
                               Foreground="{DynamicResource TextSecondary}"
                               FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                               Background="Transparent"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>


            </DockPanel>

        </Border>



        <!-- Drag and Drop -->
        <Border x:Name="DragAndDropPopup"
                Panel.ZIndex="100"
                Background="#66000000"
                Opacity="1"
                Visibility="Collapsed">

            <Border Background="{DynamicResource AppBackgroundSecondary}"
                    BorderBrush="{DynamicResource TextStrong}"
                    BorderThickness="1.5"
                    Padding="15,10"
                    Margin="0,0,0,150"
                    CornerRadius="5"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="DragandDropText" Text="Test Text"
                           Foreground="{DynamicResource TextStrong}"
                           FontFamily="{DynamicResource DefaultFont}" FontSize="25"/>
            </Border>

        </Border>



        <Border BorderThickness="1.5" BorderBrush="{DynamicResource TextSecondary}" Padding="5,0,5,5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="155" x:Name="ThumbnailViewRow"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" MinWidth="350" x:Name="SideViewColumn"/>
                    <ColumnDefinition Width="3" x:Name="SideViewSplitterColumn"/>
                    <ColumnDefinition Width="6.8*" MinWidth="200"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="2.5*" MinWidth="300" x:Name="DestinationViewColumn"/>
                </Grid.ColumnDefinitions>

                
                <GridSplitter Grid.Row="0" Grid.Column="1"
                              Width="3"
                              IsTabStop="False"
                              ResizeDirection="Columns"
                              HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource Seperator}"
                              PreviewKeyDown="GridSplitter_PreviewKeyDown"
                              MouseDoubleClick="SideViewGridSplitter_MouseDoubleClick"/>
                
                <GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="4"
                              Width="3"
                              IsTabStop="False"
                              ResizeDirection="Columns"
                              HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource Seperator}"
                              PreviewKeyDown="GridSplitter_PreviewKeyDown"
                              MouseDoubleClick="DestinationViewSplitter_MouseDoubleClick"/>

                
                <!-- Destinations & History -->
                <DockPanel LastChildFill="True"
                           Grid.Column="4" Grid.Row="0" Grid.RowSpan="4">

                    <!-- Template controls -->
                    <DockPanel DockPanel.Dock="Top"
                               LastChildFill="True">

                        <!-- Add template Button -->
                        <Button x:Name="AddTemplateBtn"
                                 DockPanel.Dock="Right"
                                 Style="{DynamicResource WindowToolButton}"
                                 ToolTip="Add template [Ctrl+T]"
                                 Width="40" Height="40"
                                 Margin="5,5,5,0"
                                 TabIndex="12"
                                 Tag="{DynamicResource ToolButtonBackgroundHover}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="AddTemplateBtn_Click">
                            <Image Source="{DynamicResource PlusIcon}" Margin="5"/>
                        </Button>

                        <!-- Destination templates -->
                        <ComboBox x:Name="DestinationTemplateBox"
                                  Style="{DynamicResource ModernComboBoxStyle}"
                                  ItemsSource="{Binding DestinationTemplates}"
                                  SelectedItem="{Binding CurrentDestinationTemplate, Mode=TwoWay}"
                                  SelectedIndex="0"
                                  Height="40"
                                  TabIndex="11"
                                  Margin="5,5,5,0"
                                  KeyDown="DestinationTemplateBox_KeyDown">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>

                                    <DockPanel LastChildFill="True">

                                        <!-- Delete template Button -->
                                        <Button x:Name="DeleteTemplateBtn"
                                                DockPanel.Dock="Right"
                                                Style="{DynamicResource WindowToolButton}"
                                                ToolTip="Delete template"
                                                Width="35" Height="35"
                                                Tag="{DynamicResource RedToolButtonBackgroundHover}"
                                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                                IsEnabled="{Binding IsDefault, Converter={StaticResource InverseBoolConvertor}}"
                                                Click="DeleteTemplateBtn_Click">
                                            <Image Source="{DynamicResource CloseIcon}" Stretch="Uniform" Margin="9"/>
                                        </Button>

                                        <!-- Edit template Button -->
                                        <Button x:Name="EditTemplateBtn"
                                                DockPanel.Dock="Right"
                                                Style="{DynamicResource WindowToolButton}"
                                                ToolTip="Edit template"
                                                Width="35" Height="35"
                                                Tag="{DynamicResource ToolButtonBackgroundHover}"
                                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                                IsEnabled="{Binding IsDefault, Converter={StaticResource InverseBoolConvertor}}"
                                                Click="EditTemplateBtn_Click">
                                            <Image Source="{DynamicResource EditIcon}" Stretch="Uniform" Margin="6"/>
                                        </Button>

                                        <!-- Destination count label -->
                                        <TextBlock FontFamily="{DynamicResource DefaultFont}" FontSize="12"
                                                   DockPanel.Dock="Bottom"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Left">
    
                                             <!-- Destination count -->
                                             <Run Text="{Binding Destinations.Count, FallbackValue='0', TargetNullValue='0', Mode=OneWay}" FontStyle="Italic"/>
                                             <!-- Destination text -->
                                             <Run Text="destination(s)" FontStyle="Italic"/>

                                        </TextBlock>

                                        <!-- Template name label -->
                                        <TextBlock Text="{Binding Name, Mode=TwoWay}"
                                                   FontFamily="{DynamicResource DefaultFont}" FontSize="20"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Left"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>

                    </DockPanel>

                    <!-- History -->
                    <StackPanel DockPanel.Dock="Bottom"
                                VerticalAlignment="Bottom">

                        <!-- Seperator -->
                        <Rectangle Stroke="{DynamicResource Seperator}" Height="2" Margin="0,0,-5,0"/>

                        <!-- History Control Bar -->
                        <DockPanel LastChildFill="False"
                                   Margin="5,5,5,5">

                            <!-- History label -->
                            <TextBlock Text="Transfer history:"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="{DynamicResource DefaultFont}" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <!-- Undo all Button -->
                            <Button x:Name="UndoAllBtn"
                                    DockPanel.Dock="Right"
                                    Style="{DynamicResource WindowToolButton}"
                                    ToolTip="Undo all"
                                    Width="25" Height="25"
                                    Margin="5,0,0,0"
                                    TabIndex="15"
                                    Tag="{DynamicResource ToolButtonBackgroundHover}"
                                    Click="UndoAllBtn_Click">
                                <Image Source="{DynamicResource UndoIcon}" Margin="1"/>
                            </Button>

                            <!-- History count label -->
                            <TextBlock Text="{Binding ElementName=HistoryList, Path=Items.Count}"
                                       DockPanel.Dock="Right"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>

                        </DockPanel>

                        <ListBox x:Name="HistoryList"
                                 Style="{DynamicResource ModernListBox}"
                                 ItemsSource="{Binding Transfers}"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 Height="250"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True"
                                               HorizontalAlignment="Stretch">

                                        <!-- Undo Button -->
                                        <Button x:Name="UndoEntryBtn"
                                                DockPanel.Dock="Right"
                                                Style="{DynamicResource WindowToolButton}"
                                                ToolTip="Undo transfer"
                                                Margin="0,0,5,0"
                                                Width="30" Height="30"
                                                Tag="{DynamicResource ToolButtonBackgroundHover}"
                                                Click="UndoEntryBtn_Click">
                                            <Image Source="{DynamicResource UndoIcon}" Margin="5"/>
                                        </Button>

                                        <!-- History entry label -->
                                        <TextBlock Margin="5,2"
                                                   VerticalAlignment="Center"
                                                   Background="Transparent"
                                                   FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                                                   TextTrimming="CharacterEllipsis"
                                                   MouseDown="TextBlock_MouseDown">
                                             <!-- Action label -->
                                             <Run Text="{Binding TransferType, Converter={StaticResource TransferActionconvertor}, FallbackValue='Transfered', TargetNullValue='Transfered', Mode=OneWay}" />
                                             <!-- Bold source name -->
                                             <Run Text="{Binding UISourceFile, FallbackValue='[Path Missing]', TargetNullValue='[Empty]', Mode=OneWay}" FontWeight="Bold"/>
                                             <LineBreak/> 
                                             <!-- to label -->
                                             <Run Text="         to "/>
                                             <!-- Bold dest name -->
                                             <Run Text="{Binding UIDestFolder, FallbackValue='[Path Missing]', TargetNullValue='[Empty]', Mode=OneWay}" FontWeight="Bold"/>

                                            <!-- Raw suffix -->
                                            <Run>
                                                 <Run.Style>
                                                     <Style TargetType="Run">
                                                         <Setter Property="Text" Value="" />
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding TransferedRaw}" Value="True">
                                                                 <Setter Property="Text" Value=" (+ RAW)" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Run.Style>
                                             </Run>
                                            
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TransferType}" Value="Delete">
                                                            <Setter Property="Foreground" Value="IndianRed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Folder Managemant -->
                    <DockPanel LastChildFill="True"
                               DockPanel.Dock="Bottom"
                               Margin="5,5,5,5">

                        <!-- Add destination Button -->
                        <Button x:Name="AddDestinationBtn"
                                DockPanel.Dock="Left"
                                Style="{DynamicResource PrimaryButton}"
                                Height="40" 
                                Margin="10,0,10,0"
                                TabIndex="13"
                                ToolTip="Add destination(s) [Ctrl+D]"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Click="AddDestinationBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{DynamicResource PlusIcon}"
                                        Width="20"
                                        Stretch="Uniform"
                                        Margin="-5,-5,0,-5"/>
                                <TextBlock Text="Destination" FontFamily="{DynamicResource DefaultFont}" FontSize="15" Margin="10,0,5,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Toggle Move-by-default Button -->
                        <CheckBox x:Name="MoveByDefaultBtn"
                                  Style="{DynamicResource ModernCheckBox}"
                                  IsChecked="{Binding MoveByDefault, Mode=TwoWay}"
                                  FontSize="20"
                                  ToolTip="Move-by-default"
                                  Height="35"
                                  Margin="5,0"
                                  TabIndex="14"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  KeyDown="MoveByDefaultBtn_KeyDown">
                            <TextBlock Text="Move-by-default"
                                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                                       TextWrapping="Wrap"/>
                        </CheckBox>

                    </DockPanel>

                    <!-- Destinations -->
                    <DockPanel LastChildFill="True">

                        <!-- Destination Control Bar -->
                        <DockPanel LastChildFill="True"
                                   DockPanel.Dock="Top"
                                   Margin="5,5,5,5">

                            <!-- History label -->
                            <TextBlock Text="Destinations:"
                                       DockPanel.Dock="Left"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="{DynamicResource DefaultFont}" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <!-- History count label -->
                            <TextBlock Text="{Binding ElementName=DestinationListList, Path=Items.Count}"
                                       DockPanel.Dock="Right"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>

                        </DockPanel>

                        <!-- Destionations -->
                        <ListBox x:Name="DestinationListList"
                                 Style="{DynamicResource ModernListBox}"
                                 Background="Transparent"
                                 ItemsSource="{Binding CurrentDestinationTemplate.Destinations}"
                                 BorderBrush="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <!-- Disable item selection -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True"
                                               Background="{DynamicResource AppBackgroundSecondary}"
                                               Height="80"
                                               Margin="10,0,0,5"
                                               HorizontalAlignment="Stretch">

                                        <!-- Reorder controls -->
                                        <DockPanel DockPanel.Dock="Right"
                                                   LastChildFill="False">

                                            <!-- Move up Button -->
                                            <Button x:Name="MoveDestinationUpBtn"
                                                    DockPanel.Dock="Top"
                                                    Style="{DynamicResource WindowToolButton}"
                                                    ToolTip="Move up"
                                                    Width="38" Height="38"
                                                    Tag="{DynamicResource ToolButtonBackgroundHover}"
                                                    VerticalAlignment="Top"
                                                    Click="MoveDestinationUpBtn_Click">
                                                <Image Source="{DynamicResource MoveUpIcon}" Stretch="Uniform" Margin="5"/>
                                            </Button>

                                            <!-- Move down Button -->
                                            <Button x:Name="MoveDestinationDownBtn"
                                                    DockPanel.Dock="Bottom"
                                                    Style="{DynamicResource WindowToolButton}"
                                                    ToolTip="Move down"
                                                    Width="38" Height="38"
                                                    Tag="{DynamicResource ToolButtonBackgroundHover}"
                                                    VerticalAlignment="Bottom"
                                                    Click="MoveDestinationDownBtn_Click">
                                                <Image Source="{DynamicResource MoveDownIcon}" Stretch="Uniform" Margin="5"/>
                                            </Button>

                                        </DockPanel>


                                        <!-- Destination control buttons -->
                                        <StackPanel Orientation="Horizontal"
                                                    DockPanel.Dock="Bottom"
                                                    Height="35">

                                            <!-- Copy Button -->
                                            <Button x:Name="CopyToDestinationBtn"
                                                    Style="{DynamicResource PrimaryButton}"
                                                    Padding="10,3,10,0"
                                                    Margin="0,0,25,0"
                                                    Click="CopyToDestinationBtn_Click">
                                                <Button.ToolTip>
                                                    <TextBlock VerticalAlignment="Center"
                                                               Background="Transparent"
                                                               FontFamily="{DynamicResource DefaultFont}" FontSize="12"
                                                               Foreground="{DynamicResource TextStrong}"
                                                               TextTrimming="CharacterEllipsis">
                                                         <Run Text="Copy to"/>
                                                         <Run Text="{Binding UIDestPath, FallbackValue='[Path missing]', TargetNullValue='[Empty]', Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Button.ToolTip>

                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{DynamicResource CopyIcon}"
                                                            Width="20"
                                                            Stretch="Uniform"/>
                                                    <TextBlock Text="Copy" FontFamily="{DynamicResource DefaultFont}" FontSize="15" Margin="10,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Move Button -->
                                            <Button x:Name="MoveToDestinationBtn"
                                                    Style="{DynamicResource OrangeButton}"
                                                    Padding="10,3,10,0"
                                                    Click="MoveToDestinationBtn_Click">
                                                <Button.ToolTip>
                                                    <TextBlock VerticalAlignment="Center"
                                                               Background="Transparent"
                                                               FontFamily="{DynamicResource DefaultFont}" FontSize="12"
                                                               Foreground="{DynamicResource TextStrong}"
                                                               TextTrimming="CharacterEllipsis">
                                                         <Run Text="Move to"/>
                                                         <Run Text="{Binding UIDestPath, FallbackValue='[Path missing]', TargetNullValue='[Empty]', Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Button.ToolTip>

                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{DynamicResource MoveIcon}"
                                                           Width="20"
                                                           Stretch="Uniform"/>
                                                    <TextBlock Text="Move" FontFamily="{DynamicResource DefaultFont}" FontSize="15" Margin="10,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                        </StackPanel>

                                        <!-- Delete Destination Button -->
                                        <Button x:Name="DeleteDestinationBtn"
                                                DockPanel.Dock="Right"
                                                Style="{DynamicResource WindowToolButton}"
                                                ToolTip="Delete destination"
                                                Width="38" Height="38"
                                                Tag="{DynamicResource RedToolButtonBackgroundHover}"
                                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Click="DeleteDestinationBtn_Click">
                                            <Image Source="{DynamicResource CloseIcon}" Stretch="Uniform" Margin="9"/>
                                        </Button>

                                        <!-- Edit Destination Button -->
                                        <Button x:Name="EditDestinationBtn"
                                                DockPanel.Dock="Right"
                                                Style="{DynamicResource WindowToolButton}"
                                                ToolTip="Browse folder"
                                                Width="38" Height="38"
                                                Tag="{DynamicResource ToolButtonBackgroundHover}"
                                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Click="EditDestinationBtn_Click">
                                            <Image Source="{DynamicResource OpenFolderIcon}" Stretch="Uniform" Margin="5"/>
                                        </Button>

                                        <!-- Destination number -->
                                        <TextBlock Text="{Binding UINumber, FallbackValue='0:', TargetNullValue='0:', Mode=OneWay}"
                                                   DockPanel.Dock="Left"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                                                   Margin="0,0,5,0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" TextAlignment="Left"
                                                   PreviewMouseDown="TextBlock_PreviewMouseDown"/>
                                        <!-- Destination path -->
                                        <TextBlock Text="{Binding UIDestPath, FallbackValue='[Path missing]', TargetNullValue='[Empty]', Mode=OneWay}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" TextAlignment="Left"
                                                   PreviewMouseDown="TextBlock_PreviewMouseDown">

                                            <TextBlock.ToolTip>
                                                <TextBlock Background="Transparent"
                                                           FontFamily="{DynamicResource DefaultFont}" FontSize="12"
                                                           Foreground="{DynamicResource TextStrong}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding DestPath, FallbackValue='[Path missing]', TargetNullValue='[Empty]', Mode=OneWay}"/>
                                                    <LineBreak/>
                                                    <Run Text="{Binding Counter, StringFormat='{}{0} transfers', FallbackValue=0, TargetNullValue=0, Mode=OneWay}"/>
                                                </TextBlock>
                                            </TextBlock.ToolTip>

                                        </TextBlock>

                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </DockPanel>

                </DockPanel>

                <!-- Side View -->
                <DockPanel Grid.Row="0" Grid.Column="0">

                    <!-- Side View Control Bar -->
                    <DockPanel LastChildFill="True"
                               DockPanel.Dock="Top"
                               Margin="5,5,5,5">

                        <!-- Files label -->
                        <TextBlock Text="Transfered images:"
                                   DockPanel.Dock="Left"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="{DynamicResource DefaultFont}" FontSize="15" FontWeight="Bold"/>

                        <!-- File counter -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TransferedImageCount, FallbackValue='0', TargetNullValue='0', Mode=OneWay}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"/>
                            <TextBlock Text="/"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"/>
                            <TextBlock Text="{Binding ElementName=ImageListBox, FallbackValue='0', TargetNullValue='0', Path=Items.Count, Mode=OneWay}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="{DynamicResource DefaultFont}" FontSize="15"/>
                        </StackPanel>

                    </DockPanel>

                    <!-- Image list -->
                    <ListBox x:Name="ImageListBox"
                             Style="{DynamicResource ModernListBox}"
                             ItemsSource="{Binding Images}"
                             Background="Transparent" 
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ImageListBox_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="ImageListBox_MouseDoubleClick"
                             MouseDown="ImageListBox_MouseDown"
                             PreviewKeyDown="ImageListBox_PreviewKeyDown"
                             PreviewMouseRightButtonDown="ImageListBox_PreviewMouseRightButtonDown">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5"
                                        ToolTipService.ShowOnDisabled="True"
                                        ContextMenuService.ShowOnDisabled="True">

                                    <DockPanel LastChildFill="True"
                                               Margin="5">

                                        <Image Width="15" DockPanel.Dock="Right" Source="{DynamicResource DeleteImageIcon}" Stretch="Uniform" Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed'}" Margin="5,0,0,0"/>
                                        <Image Width="15" DockPanel.Dock="Right" Source="{DynamicResource MoveIcon}" Stretch="Uniform" Visibility="{Binding IsMoved, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed'}" Margin="5,0,0,0"/>
                                        <Image Width="15" DockPanel.Dock="Right" Source="{DynamicResource CopyIcon}" Stretch="Uniform" Visibility="{Binding IsCopied, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed'}" Margin="5,0,0,0"/>
                                        <TextBlock Text="RAW" 
                                                   DockPanel.Dock="Right"
                                                   FontFamily="{DynamicResource DefaultFont}" 
                                                   FontSize="14" 
                                                   Width="40"
                                                   Foreground="{DynamicResource TextSecondary}" 
                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                   Margin="5,0,0,0"
                                                   Visibility="{Binding HasRaw, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed'}"/>
                                        <Image Width="15" DockPanel.Dock="Left" Source="{DynamicResource MarkIcon}" Stretch="Uniform" Visibility="{Binding IsMarked, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed'}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding UINumber, StringFormat='{}{0}.', FallbackValue='0', TargetNullValue='0', Mode=OneWay}" 
                                                   DockPanel.Dock="Left"
                                                   MinWidth="25"
                                                   FontFamily="{DynamicResource DefaultFont}" 
                                                   FontSize="14" 
                                                   Foreground="{DynamicResource TextSecondary}" 
                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding UIShortPath, FallbackValue='[Path missing]', TargetNullValue='[Empty]'}" FontFamily="{DynamicResource DefaultFont}" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="5,0,0,0"/>
                                    </DockPanel>

                                    <Border.ToolTip>
                                        <TextBlock VerticalAlignment="Center"
                                                   Background="Transparent"
                                                   FontFamily="{DynamicResource DefaultFont}" FontSize="12"
                                                   Foreground="{DynamicResource TextStrong}"
                                                   TextTrimming="CharacterEllipsis">
                                                <!-- Copy count -->
                                                <Run Text="Copied"/>
                                                <Run Text="{Binding CopyCount, FallbackValue='0', TargetNullValue='0', Mode=OneWay}" />
                                                <Run Text="time(s)"/>
                                                <LineBreak/> 
                                                <!-- Move count -->
                                                <Run Text="Moved"/>
                                                <Run Text="{Binding MoveCount, FallbackValue='0', TargetNullValue='0', Mode=OneWay}" />
                                                <Run Text="time(s)"/>
                                        </TextBlock>
                                    </Border.ToolTip>

                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <!-- Change background to green when IsInSplitView is true -->
                                                <DataTrigger Binding="{Binding IsInSplitView, FallbackValue='False', TargetNullValue='False'}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListItemBackgroundHover}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Mark" IsChecked="{Binding IsMarked, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuMarkItem_Click"/>
                                            <MenuItem Header="Undo" IsEnabled="{Binding IsTransfered, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuUndoItem_Click"/>
                                            <MenuItem Header="Split View" IsChecked="{Binding IsInSplitView, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" IsEnabled="{Binding IsEnabled, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuSplitViewItem_Click"/>
                                            <MenuItem Header="Open in Explorer" IsEnabled="{Binding IsEnabled, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuOpenExplorerItem_Click"/>
                                            <MenuItem Header="Copy to" IsEnabled="{Binding IsEnabled, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuCopyToItem_Click"/>
                                            <MenuItem Header="Move to" IsEnabled="{Binding IsEnabled, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuMoveToItem_Click"/>
                                            <MenuItem Header="Delete" IsEnabled="{Binding IsEnabled, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuDeleteItem_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>

                <!-- Image View -->
                <Grid Grid.Row="0" Grid.Column="2">

                    <!-- Previous Image Overlay Button -->
                    <Button x:Name="PreviousImageOverlayBtn"
                            Style="{DynamicResource OverlayButton}"
                            Margin="10"
                            Panel.ZIndex="5"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Cursor="Hand"
                            Click="PreviousImageBtn_Click">
                        <Image Source="{DynamicResource PreviousImageIcon}"
                               Width="30"
                               Margin="0,10,10,10"
                               Stretch="Uniform"/>
                    </Button>

                    <!-- Next Image Overlay Button -->
                    <Button x:Name="NextImageOverlayBtn"
                            Style="{DynamicResource OverlayButton}"
                            Margin="10"
                            Panel.ZIndex="5"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Cursor="Hand"
                            Click="NextImageBtn_Click">
                        <Image Source="{DynamicResource NextImageIcon}"
                               Width="30"
                               Margin="10,10,0,10"
                               Stretch="Uniform"/>
                    </Button>

                    <!-- Split view -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*" x:Name="SplitViewColumn"/>
                            <ColumnDefinition Width="0" x:Name="SplitViewSeperator"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Image -->
                        <lmimgz:ImageZoom x:Name="SplitImage"
                                          Grid.Column="0"
                                          Source="{DynamicResource DefaultImage}"
                                          Background="Black"
                                          MinZoomRatio="0.01"
                                          MaxZoomRatio="8"
                                          MoveCursor="SizeAll"
                                          PreviewMouseRightButtonDown="SplitImage_PreviewMouseRightButtonDown"
                                          PreviewMouseDown="SplitImage_PreviewMouseDown"/>

                        <!-- Image name -->
                        <Viewbox x:Name="SplitViewFileNameArea" Grid.Column="0" Grid.Row="0" Panel.ZIndex="1"
                                 Margin="50,10,50,10"
                                 Height="50"
                                 Cursor="Hand"
                                 HorizontalAlignment="Center" VerticalAlignment="Top"
                                 MouseDown="FileNameLabel_MouseDown">
                            <Border CornerRadius="5"
                                    Padding="10"
                                    Background="{DynamicResource AppBackgroundSecondary}"
                                    Opacity="0.75">
                                <TextBlock x:Name="SplitViewFileNameLabel"
                                           Text="{Binding CurrentSplitViewImage.UIFileName, FallbackValue='PATH', TargetNullValue='[Empty]', Mode=OneWay}"
                                           FontFamily="{DynamicResource DefaultFont}" FontSize="25"
                                           Foreground="{DynamicResource TextPrimary}" 
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Viewbox>

                        <!-- Seperator -->
                        <Rectangle Stroke="{DynamicResource Seperator}" Grid.Column="1" Width="2"/>

                        <!-- Image -->
                        <lmimgz:ImageZoom x:Name="Image"
                                          Grid.Column="2"
                                          Source="{DynamicResource DefaultImage}"
                                          Background="Black"
                                          MinZoomRatio="0.01"
                                          MaxZoomRatio="8"
                                          MoveCursor="SizeAll"
                                          TabIndex="0"
                                          PreviewMouseRightButtonDown="Image_PreviewMouseRightButtonDown"
                                          PreviewMouseDown="Image_PreviewMouseDown"/>

                        <!-- Image name -->
                        <Viewbox x:Name="FileNameArea" Grid.Column="2" Grid.Row="0" Panel.ZIndex="1"
                                 Margin="50,10,50,10"
                                 Height="50"
                                 Cursor="Hand"
                                 HorizontalAlignment="Center" VerticalAlignment="Top"
                                 MouseDown="FileNameLabel_MouseDown">
                            <Border CornerRadius="5"
                                    Padding="10"
                                    Background="{DynamicResource AppBackgroundSecondary}"
                                    Opacity="0.75">
                                <TextBlock x:Name="FileNameLabel"
                                           Text="{Binding ElementName=ImageListBox, Path=SelectedItem.UIFileName, FallbackValue='PATH', TargetNullValue='[Empty]', Mode=OneWay}"
                                           FontFamily="{DynamicResource DefaultFont}" FontSize="25"
                                           Foreground="{DynamicResource TextPrimary}" 
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Viewbox>

                    </Grid>

                </Grid>

                <!-- Thumbnails -->
                <Border x:Name="ThumbnailArea"
                        Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        ScrollViewer.HorizontalScrollBarVisibility="Visible"
                        Background="{DynamicResource AppBackgroundSecondary}"
                        Height="155"
                        Padding="10,0"
                        Visibility="{Binding ElementName=ToggleThumbnailViewBtn, Path=IsChecked, Converter={StaticResource BoolToVis}, Mode=OneWay}">

                    <StackPanel>

                        <!-- Seperator -->
                        <Rectangle Stroke="{DynamicResource Seperator}" Height="2" Margin="-15,0,-10,0"/>

                        <!-- Thumbnails -->
                        <ListBox x:Name="ThumbnailListBox"
                                 Style="{DynamicResource ThumbnailListBox}"
                                 ItemsSource="{Binding Images}"
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 Height="110"
                                 Margin="0,10,0,0"
                                 SelectedIndex="{Binding ElementName=ImageListBox, Path=SelectedIndex, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 PreviewMouseWheel="PreviewThumbnailListBox_MouseWheel"
                                 MouseDoubleClick="ThumbnailListBox_MouseDoubleClick"
                                 MouseDown="ThumbnailListBox_MouseDown"
                                 PreviewKeyDown="ThumbnailListBox_PreviewKeyDown"
                                 PreviewMouseRightButtonDown="ThumbnailListBox_PreviewMouseRightButtonDown">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="70" Width="100" Margin="2"
                                          ToolTipService.ShowOnDisabled="True"
                                          ContextMenuService.ShowOnDisabled="True">

                                        <Border CornerRadius="4" BorderBrush="Transparent" BorderThickness="2" x:Name="ThumbBorder">
                                            <StackPanel>
                                                <Image Height="40" Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                    <!-- Image raw tag -->
                                                    <TextBlock Text="RAW"
                                                               FontFamily="{DynamicResource DefaultFont}" 
                                                               FontSize="14" 
                                                               Width="40"
                                                               Foreground="DarkGray" 
                                                               HorizontalAlignment="Left" TextAlignment="Left"
                                                               Margin="2,0,0,0"
                                                               Visibility="{Binding HasRaw, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed'}"/>

                                                    <!-- Image number -->
                                                    <TextBlock Text="{Binding UINumber, StringFormat='{}{0}.', FallbackValue='0', TargetNullValue='0', Mode=OneWay}"
                                                               FontFamily="{DynamicResource DefaultFont}" 
                                                               FontSize="14" 
                                                               Height="20"
                                                               Foreground="DarkGray" 
                                                               HorizontalAlignment="Center" TextAlignment="Left">
                                                    </TextBlock>

                                                </StackPanel>

                                            </StackPanel>

                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <!-- Change background to green when IsInSplitView is true -->
                                                        <DataTrigger Binding="{Binding IsInSplitView, FallbackValue='False', TargetNullValue='False'}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SplitViewBackground}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <DockPanel LastChildFill="False" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                            <Image Width="20" Source="{DynamicResource DeleteImageIcon}" DockPanel.Dock="Right" Stretch="Uniform" Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed'}" Margin="5,0,0,0"/>
                                            <Image Width="20" Source="{DynamicResource MoveIcon}" DockPanel.Dock="Right" Stretch="Uniform" Visibility="{Binding IsMoved, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed'}" Margin="5,0,0,0"/>
                                            <Image Width="20" Source="{DynamicResource CopyIcon}" DockPanel.Dock="Right" Stretch="Uniform" Visibility="{Binding IsCopied, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed'}" Margin="5,0,0,0"/>
                                            <Image Width="20" Source="{DynamicResource MarkIcon}" DockPanel.Dock="Left" Stretch="Uniform" Visibility="{Binding IsMarked, Converter={StaticResource BoolToVis}, FallbackValue='Collapsed', TargetNullValue='Collapsed'}" Margin="0,0,5,0"/>
                                        </DockPanel>

                                        <Grid.ToolTip>
                                            <TextBlock VerticalAlignment="Center"
                                                       Background="Transparent"
                                                       FontFamily="{DynamicResource DefaultFont}" FontSize="12"
                                                       Foreground="{DynamicResource TextStrong}"
                                                       TextTrimming="CharacterEllipsis">
                                                <!-- Copy count -->
                                                <Run Text="Copied"/>
                                                <Run Text="{Binding CopyCount, FallbackValue='0', TargetNullValue='0', Mode=OneWay}" />
                                                <Run Text="time(s)"/>
                                                <LineBreak/> 
                                                <!-- Move count -->
                                                <Run Text="Moved"/>
                                                <Run Text="{Binding MoveCount, FallbackValue='0', TargetNullValue='0', Mode=OneWay}" />
                                                <Run Text="time(s)"/>
                                            </TextBlock>
                                        </Grid.ToolTip>

                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Mark" IsChecked="{Binding IsMarked, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuMarkItem_Click"/>
                                                <MenuItem Header="Undo" IsEnabled="{Binding IsTransfered, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuUndoItem_Click"/>
                                                <MenuItem Header="Split View" IsChecked="{Binding IsInSplitView, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" IsEnabled="{Binding IsEnabled, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuSplitViewItem_Click"/>
                                                <MenuItem Header="Open in Explorer" IsEnabled="{Binding IsEnabled, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuOpenExplorerItem_Click"/>
                                                <MenuItem Header="Copy to" IsEnabled="{Binding IsEnabled, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuCopyToItem_Click"/>
                                                <MenuItem Header="Move to" IsEnabled="{Binding IsEnabled, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuMoveToItem_Click"/>
                                                <MenuItem Header="Delete" IsEnabled="{Binding IsEnabled, FallbackValue='False', TargetNullValue='False', Mode=OneWay}" Click="ContextMenuDeleteItem_Click"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Image Slider -->
                        <Slider x:Name="ImageSlider"
                                 Style="{DynamicResource ModernSlider}"
                                 Minimum="1" Maximum="{Binding ElementName=ImageListBox, Path=Items.Count}" TickFrequency="0.01"
                                 Height="30"
                                 Margin="10,0"
                                 AutoToolTipPlacement="TopLeft"
                                 IsMoveToPointEnabled="True"
                                 PreviewKeyDown="ImageSlider_PreviewKeyDown"
                                 ValueChanged="ImageSlider_ValueChanged"/>

                    </StackPanel>

                </Border>

                <!-- Seperator -->
                <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Stroke="{DynamicResource Seperator}" Height="2" Margin="-5,0,0,0"/>

                <!-- Image Controls -->
                <DockPanel x:Name="ControlBar"
                           Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                           LastChildFill="True"
                           Height="60" Margin="10"
                           VerticalAlignment="Center">

                    <!-- Save Image Button -->
                    <Button x:Name="SaveImageBtn"
                            DockPanel.Dock="Left"
                            Style="{DynamicResource PrimaryButton}"
                            Margin="10,0"
                            TabIndex="3"
                            Click="SaveImageBtn_Click">
                        <Button.ToolTip>
                            <TextBlock VerticalAlignment="Center"
                                       Background="Transparent"
                                       FontFamily="{DynamicResource DefaultFont}" FontSize="12"
                                       Foreground="{DynamicResource TextStrong}"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Safe/copy image [Ctrl+S]"/>
                                <LineBreak/>
                                <Run Text="Move image [Ctrl+Shift+S]"/>
                            </TextBlock>
                        </Button.ToolTip>

                        <StackPanel Orientation="Horizontal">
                            <Image Source="{DynamicResource ImageSizeIcon}"
                                   Width="40"
                                   Stretch="Uniform"/>
                            <TextBlock Text="Save" FontFamily="{DynamicResource DefaultFont}" FontSize="25" Margin="10,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Previous Image Button -->
                    <Button x:Name="MarkImageBtn"
                            Style="{DynamicResource PrimaryButton}"
                            Margin="10,0"
                            TabIndex="4"
                            ToolTip="Mark image [M]"
                            Click="MarkImageBtn_Click">
                        <Image Source="{DynamicResource MarkIcon}"
                               Width="40"
                               Stretch="Uniform"/>
                    </Button>

                    <!-- Delete Image Button -->
                    <Button x:Name="DeleteImageBtn"
                            DockPanel.Dock="Right"
                            Style="{DynamicResource RedButton}"
                            Margin="10,0"
                            TabIndex="10"
                            Click="DeleteImageBtn_Click">
                        <Button.ToolTip>
                            <TextBlock VerticalAlignment="Center"
                                       Background="Transparent"
                                       FontFamily="{DynamicResource DefaultFont}" FontSize="12"
                                       Foreground="{DynamicResource TextStrong}"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Delete image [Del]"/>
                                <LineBreak/>
                                <Run Text="This action is undoable via the trash."/>
                                <LineBreak/> 
                                <LineBreak/> 
                                <Run Text="Delete image permanantly (Ctrl+Del)"/>
                                <LineBreak/>
                                <Run Text="This action is not undoable!" FontWeight="Bold"/>
                            </TextBlock>
                        </Button.ToolTip>

                        <Image Source="{DynamicResource DeleteImageIcon}"
                               Width="40"
                               Stretch="Uniform"/>
                    </Button>

                    <!-- Undo Button -->
                    <Button x:Name="UndoBtn"
                            DockPanel.Dock="Right"
                            Style="{DynamicResource PrimaryButton}"
                            Margin="10,0"
                            TabIndex="9"
                            ToolTip="Undo [Ctrl+Z]"
                            Click="UndoBtn_Click">
                        <Image Source="{DynamicResource UndoIcon}"
                               Width="40"
                               Stretch="Uniform"/>
                    </Button>

                    <!-- Control Bar -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Center">

                        <!-- Previous Image Button -->
                        <Button x:Name="PreviousImageBtn"
                                Style="{DynamicResource PrimaryButton}"
                                Margin="10,0"
                                TabIndex="5"
                                Click="PreviousImageBtn_Click">
                            <Button.ToolTip>
                                <TextBlock VerticalAlignment="Center"
                                           Background="Transparent"
                                           FontFamily="{DynamicResource DefaultFont}" FontSize="12"
                                           Foreground="{DynamicResource TextStrong}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="Previous image [LeftArrow]"/>
                                    <LineBreak/>
                                    <Run Text="Previous marked image [Shift+LeftArrow]"/>
                                </TextBlock>
                            </Button.ToolTip>

                            <Image Source="{DynamicResource PreviousImageIcon}"
                                   Width="40"
                                   Stretch="Uniform"/>
                        </Button>

                        <!-- Rotate Left Button -->
                        <Button x:Name="RotateLeftBtn"
                                Style="{DynamicResource PrimaryButton}"
                                Margin="10,0"
                                ToolTip="Rotate image left [DownArrow]"
                                TabIndex="6"
                                Click="RotateLeftBtn_Click">
                            <Image Source="{DynamicResource RotateImageLeftIcon}"
                                   Width="40"
                                   Stretch="Uniform"/>
                        </Button>

                        <!-- Rotate Right Button -->
                        <Button x:Name="RotateRightBtn"
                                Style="{DynamicResource PrimaryButton}"
                                Margin="10,0"
                                ToolTip="Rotate image right [UpArrow]"
                                TabIndex="7"
                                Click="RotateRightBtn_Click">
                            <Image Source="{DynamicResource RotateImageRightIcon}"
                                   Width="40"
                                   Stretch="Uniform"/>
                        </Button>

                        <!-- Next Image Button -->
                        <Button x:Name="NextImageBtn"
                                Style="{DynamicResource PrimaryButton}"
                                Margin="10,0"
                                TabIndex="8"
                                Click="NextImageBtn_Click">
                            <Button.ToolTip>
                                <TextBlock VerticalAlignment="Center"
                                           Background="Transparent"
                                           FontFamily="{DynamicResource DefaultFont}" FontSize="12"
                                           Foreground="{DynamicResource TextStrong}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="Next image [RightArrow]"/>
                                    <LineBreak/>
                                    <Run Text="Next marked image [Shift+RightArrow]"/>
                                </TextBlock>
                            </Button.ToolTip>

                            <Image Source="{DynamicResource NextImageIcon}"
                                   Width="40"
                                   Stretch="Uniform"/>
                        </Button>

                    </StackPanel>

                </DockPanel>

                <!-- Status Bar -->
                <DockPanel x:Name="StatusBar"
                           Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"
                           LastChildFill="True">

                    <!-- Seperator -->
                    <Rectangle DockPanel.Dock="Top" Stroke="{DynamicResource Seperator}" Height="2" Margin="-5,0"/>

                    <!-- Toggle Thumbnails Button -->
                    <ToggleButton x:Name="ToggleSideViewBtn"
                                  Style="{DynamicResource WindowToolToggleButton}"
                                  IsChecked="True"
                                  ToolTip="Toggle Side view [L]"
                                  Width="30" Height="30"
                                  TabIndex="15"
                                  Tag="{DynamicResource ToolButtonBackgroundHover}"
                                  Checked="ToggleSideViewBtn_IsCheckedChanged"
                                  Unchecked="ToggleSideViewBtn_IsCheckedChanged">
                        <Image Source="{DynamicResource SideViewIcon}" Margin="5"/>
                    </ToggleButton>

                    <!-- Toggle Thumbnails Button -->
                    <ToggleButton x:Name="ToggleThumbnailViewBtn"
                                  Style="{DynamicResource WindowToolToggleButton}"
                                  IsChecked="True"
                                  ToolTip="Toggle Thumbnails [H]"
                                  Width="30" Height="30"
                                  TabIndex="16"
                                  Margin="5,0,0,0"
                                  Tag="{DynamicResource ToolButtonBackgroundHover}"
                                  Checked="ToggleThumbnailViewBtn_IsCheckedChanged"
                                  Unchecked="ToggleThumbnailViewBtn_IsCheckedChanged">
                        <Image Source="{DynamicResource ThumbnailViewIcon}" Margin="5"/>
                    </ToggleButton>

                    <!-- Toggle Thumbnails Button -->
                    <ToggleButton x:Name="ToggleSplitViewBtn"
                                  Style="{DynamicResource WindowToolToggleButton}"
                                  IsChecked="False"
                                  ToolTip="Toggle split view [S]"
                                  Width="30" Height="30"
                                  TabIndex="17"
                                  Margin="5,0,15,0"
                                  Tag="{DynamicResource ToolButtonBackgroundHover}"
                                  Checked="ToggleSplitViewBtn_CheckedChanged"
                                  Unchecked="ToggleSplitViewBtn_CheckedChanged">
                        <Image Source="{DynamicResource SplitViewIcon}" Margin="5"/>
                    </ToggleButton>

                    <!-- File Type Text -->
                    <TextBlock x:Name="TypeText" Text="{Binding ElementName=ImageListBox, Path=SelectedItem.Type, FallbackValue='UNK', TargetNullValue='[Empty]', Mode=OneWay}"
                               MinWidth="35"
                               DockPanel.Dock="Left"
                               ToolTip="{Binding ElementName=ImageListBox, Path=SelectedItem.Type, FallbackValue='RESOLUTION', TargetNullValue='[Empty]', Mode=OneWay}"
                               FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="10"
                               VerticalAlignment="Center" TextAlignment="Center"/>

                    <!-- Resolution Text -->
                    <ToggleButton x:Name="ToggleResolutionBtn"
                                  Style="{DynamicResource WindowToolToggleButton}"
                                  DockPanel.Dock="Left"
                                  IsChecked="{Binding LoadFullResolution}"
                                  ToolTip="Toggle full resolution (impacts performance) [R]"
                                  Width="30" Height="30"
                                  TabIndex="18"
                                  Margin="5,0,10,0"
                                  Tag="{DynamicResource ToolButtonBackgroundHover}">
                        <Image Source="{DynamicResource ImageResolutionIcon}" Margin="2"/>
                    </ToggleButton>

                    <TextBlock x:Name="ResolutionText"
                               MinWidth="100"
                               DockPanel.Dock="Left"
                               ToolTip="{Binding ElementName=ResolutionText, Path=Text, FallbackValue='0x0px', TargetNullValue='0x0px', Mode=OneWay}"
                               FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,2,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}x{1}px" FallbackValue="0x0px" TargetNullValue="0x0px" Mode="OneWay">
                                <Binding ElementName="ImageListBox" Path="SelectedItem.ResolutionWidth" FallbackValue="0" TargetNullValue="0" Mode="OneWay"/>
                                <Binding ElementName="ImageListBox" Path="SelectedItem.ResolutionHeight" FallbackValue="0" TargetNullValue="0" Mode="OneWay"/>
                                <!--<Binding ElementName="Image" Path="TranslateX" FallbackValue="0" TargetNullValue="0" Mode="OneWay"/>
                                <Binding ElementName="Image" Path="TranslateY" FallbackValue="0" TargetNullValue="0" Mode="OneWay"/>-->
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- Size Text -->
                    <Image Source="{DynamicResource ImageSizeIcon}"
                           DockPanel.Dock="Left"
                           Margin="10,10,10,10"
                           Opacity="0.7"/>

                    <TextBlock x:Name="SizeText" Text="{Binding ElementName=ImageListBox, Path=SelectedItem.Size, Converter={StaticResource FileSizeConvertor}, FallbackValue='0 KB', TargetNullValue='0 KB', Mode=OneWay}"
                               MinWidth="60"
                               DockPanel.Dock="Left"
                               ToolTip="{Binding ElementName=SizeText, Path=Text, FallbackValue='0 KB', TargetNullValue='0 KB', Mode=OneWay}"
                               FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,2,0,0"/>

                    <!-- Size Text -->
                    <Image Source="{DynamicResource ImageDateIcon}"
                           DockPanel.Dock="Left"
                           Margin="10,10,10,10"
                           Opacity="0.7"/>

                    <TextBlock x:Name="CaptureDateText" Text="{Binding ElementName=ImageListBox, Path=SelectedItem.CaptureDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}', FallbackValue='01.01.2000 00:00', TargetNullValue='01.01.2000 00:00', Mode=OneWay}"
                               MinWidth="60"
                               DockPanel.Dock="Left"
                               ToolTip="{Binding ElementName=CaptureDateText, Path=Text, FallbackValue='01.01.2000 00:00', TargetNullValue='01.01.2000 00:00', Mode=OneWay}"
                               FontFamily="{DynamicResource DefaultFont}" FontSize="15"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,2,0,0">
                    </TextBlock>

                    <!-- Resize Grip -->
                    <Image Source="{DynamicResource ResizeGripIcon}"
                           DockPanel.Dock="Right"
                           Stretch="Uniform"
                           Height="20" Width="20"
                           Margin="0,0,-5,-5" 
                           WindowChrome.ResizeGripDirection="BottomRight"
                           VerticalAlignment="Bottom" HorizontalAlignment="Right"/>

                    <!-- Zoom controls -->
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                Height="40"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top">

                        <!-- Zoom out Button -->
                        <Button x:Name="ZoomOutBtn"
                                Style="{DynamicResource WindowToolButton}"
                                ToolTip="Zoom Out"
                                Margin="0,0,5,0"
                                Width="30" Height="30"
                                Tag="{DynamicResource ToolButtonBackgroundHover}"
                                TabIndex="19"
                                Click="ZoomOutBtn_Click">
                            <Image Source="{DynamicResource ZoomOutIcon}" Margin="5"/>
                        </Button>

                        <!-- Zoom Slider -->
                        <Slider x:Name="ZoomSlider"
                                Width="150" 
                                Style="{DynamicResource ModernSlider}"
                                Value="{Binding ElementName=Image,Path=ZoomRatio,Mode=TwoWay}" Minimum="{Binding ElementName=Image,Path=MinZoomRatio,Mode=OneWay}" Maximum="{Binding ElementName=Image,Path=MaxZoomRatio,Mode=OneWay}" 
                                TickFrequency="0.1"
                                VerticalAlignment="Center"
                                ToolTip="Zoom control"
                                IsMoveToPointEnabled="True"
                                MouseDoubleClick="ZoomSlider_MouseDoubleClick"
                                PreviewKeyDown="ZoomSlider_PreviewKeyDown"
                                ValueChanged="ZoomSlider_ValueChanged"/>



                        <!-- Zoom in Button -->
                        <Button x:Name="ZoomInBtn"
                                Style="{DynamicResource WindowToolButton}"
                                ToolTip="Zoom In"
                                Margin="5,0,0,0"
                                Width="30" Height="30"
                                Tag="{DynamicResource ToolButtonBackgroundHover}"
                                TabIndex="20"
                                Click="ZoomInBtn_Click">
                            <Image Source="{DynamicResource ZoomInIcon}" Margin="5"/>
                        </Button>

                        <!-- Zoom Text Label -->
                        <TextBlock Text="{Binding ElementName=ZoomSlider, Path=Value, Converter={StaticResource PercentageConverter}}" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   Width="60"
                                   FontFamily="{DynamicResource DefaultFont}"
                                   FontSize="20"
                                   VerticalAlignment="Center" TextAlignment="Right"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ElementName=ImageListBox, Path=SelectedIndex, Converter={StaticResource IndexPlusOneConverter}, FallbackValue='0', TargetNullValue='0'}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="{DynamicResource DefaultFont}" FontSize="20"/>
                        <TextBlock Text="/"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="{DynamicResource DefaultFont}" FontSize="20"/>
                        <TextBlock Text="{Binding ElementName=ImageListBox, FallbackValue='0', TargetNullValue='0', Path=Items.Count}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="{DynamicResource DefaultFont}" FontSize="20"/>
                    </StackPanel>

                </DockPanel>

             </Grid>

        </Border>

    </Grid>

</Window>
